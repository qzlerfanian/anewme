# کپی این فایل به .env و مقادیر واقعی را جایگزین کنید

TELEGRAM_BOT_TOKEN=123456:ABC-YOUR-BOT-TOKEN
# شناسه عددی کاربر(های) مجاز، جدا شده با کاما (از @userinfobot بگیرید)
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# مدل باید vision-capable باشد (تصویر می‌بیند): gpt-4o یا gpt-4o-mini یا gpt-4.1
AI_MODEL=gpt-4o

WATCH_POLL_INTERVAL_SECONDS=15

# اختیاری: تعداد کندل ارسالی به هر تایم‌فریم (برای تصویر چارت).
# افزایش این اعداد یعنی مدل ساختار بلندمدت‌تری می‌بیند، ولی تصویر بزرگ‌تر
# می‌شود (هزینه پردازش تصویر OpenAI هم بیشتر می‌شود). سقف تصویر در کد
# ۲۴ اینچ عرض است تا با اعداد خیلی بزرگ هم خوانا بماند.
M5_CANDLE_COUNT=20
M15_CANDLE_COUNT=20
H1_CANDLE_COUNT=60

# سقف تعداد کندلی که به‌صورت لیست عددی متنی (نه تصویر) فرستاده می‌شود -
# مستقل از اعداد بالا. این عدد را بالا نبرید مگر واقعاً لازم باشد، چون
# مستقیم روی حجم و هزینه هر درخواست اثر می‌گذارد.
MAX_TEXT_CANDLES=30

# فقط روی ویندوز (برای اتصال واقعی به MT5) لازم است
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
